{
  "name": "graft",
  "productName": "Graft",
  "version": "1.0.0",
  "description": "A fast Git client: commit graph, line staging, conflicts, interactive rebase and undo.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.graft.git",
    "productName": "Graft",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Graft",
      "artifactName": "Graft-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Graft-Portable-${version}.exe"
    },
    "publish": null
  }
}
